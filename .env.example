# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Public base URL, used in exports / emails
BASE_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────
# SQLite file path (node:sqlite, zero native deps)
DATABASE_PATH=./data/app.db

# ── AI Provider (server-side only, NEVER expose to client) ──
# Any OpenAI-compatible chat completions endpoint works.
AI_PROVIDER=mock            # mock | openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# ── Localization Checker limits ─────────────────────────
SCAN_MAX_PAGES=10
SCAN_MAX_DEPTH=2
SCAN_TIMEOUT_MS=10000
SCAN_MAX_BODY_BYTES=1048576
SCAN_SAME_ORIGIN_ONLY=true
FREE_AUDIT_DAILY_LIMIT_ANON=3
FREE_AUDIT_MONTHLY_LIMIT_USER=3
FREE_REPORT_FULL_EXAMPLES=3

# ── AI Translation quotas ───────────────────────────────
FREE_TRANSLATE_STRINGS=100
TRANSLATE_BATCH_SIZE=20

# ── Admin ───────────────────────────────────────────────
# Token required to view /admin leads dashboard
ADMIN_TOKEN=change-me-in-production

# ── Misc ────────────────────────────────────────────────
# Cookie secret for anonymous id signing (optional)
COOKIE_SECRET=
